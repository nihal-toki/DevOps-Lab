  <execution class="org.jenkinsci.plugins.workflow.cps.CpsFlowExecution">
    <result>SUCCESS</result>
    <script>
pipeline {
    agent any

    environment {
        VENV = &quot;${WORKSPACE}/.jenkins-venv&quot;
        DEPLOY_DIR = &quot;${WORKSPACE}/python-app-deploy&quot;
    }

    stages {
        stage(&apos;Build&apos;) {
            steps {
                dir(&apos;python-flask-app&apos;) {
                    echo &apos;Creating virtual environment and installing dependencies...&apos;
                    sh &apos;&apos;&apos;
                        python3 -m venv &quot;$VENV&quot;
                        &quot;$VENV/bin/python&quot; -m pip install -r requirements.txt
                    &apos;&apos;&apos;
                }
            }
        }

        stage(&apos;Test&apos;) {
            steps {
                dir(&apos;python-flask-app&apos;) {
                    echo &apos;Running unit tests...&apos;
                    sh &apos;&apos;&apos;
                        &quot;$VENV/bin/python&quot; -m unittest discover -s . -p &quot;test_*.py&quot;
                    &apos;&apos;&apos;
                }
            }
        }

        stage(&apos;Deploy&apos;) {
            steps {
                dir(&apos;python-flask-app&apos;) {
                    echo &apos;Deploying application...&apos;
                    sh &apos;&apos;&apos;
                        mkdir -p &quot;$DEPLOY_DIR&quot;
                        cp app.py &quot;$DEPLOY_DIR/&quot;
                    &apos;&apos;&apos;
                }
            }
        }

        stage(&apos;Run Application&apos;) {
            steps {
                dir(&apos;python-flask-app&apos;) {
                    echo &apos;Checking deployed Flask application...&apos;
                    sh &apos;&apos;&apos;
                        cd &quot;$DEPLOY_DIR&quot;
                        &quot;$VENV/bin/python&quot; -c &quot;from app import app; print(app.url_map)&quot;
                    &apos;&apos;&apos;
                }
            }
        }

        stage(&apos;Test Application&apos;) {
            steps {
                dir(&apos;python-flask-app&apos;) {
                    echo &apos;Verifying deployed Flask application...&apos;
                    sh &apos;&apos;&apos;
                        cd &quot;$DEPLOY_DIR&quot;
                        &quot;$VENV/bin/python&quot; -c &quot;from app import app; r = app.test_client().get(&apos;/&apos;); assert r.status_code == 200; assert r.get_data(as_text=True) == &apos;Hello, Jenkins Multi-Stage Pipeline!&apos;; print(r.get_data(as_text=True))&quot;
                    &apos;&apos;&apos;
                }
            }
        }
    }

    post {
        success {
            echo &apos;Pipeline completed successfully!&apos;
        }

        failure {
            echo &apos;Pipeline failed. Check the console output for details.&apos;
        }

        always {
            echo &apos;Pipeline execution finished.&apos;
        }
    }
}
</script>
