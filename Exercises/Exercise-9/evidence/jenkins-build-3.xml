    <script>
pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timeout(time: 10, unit: &apos;MINUTES&apos;)
    }

    environment {
        VENV = &quot;${WORKSPACE}/.jenkins-venv&quot;
        DEPLOY_DIR = &quot;${WORKSPACE}/python-app-deploy&quot;
    }

    stages {
        stage(&apos;Build&apos;) {
            steps {
                dir(&apos;python-flask-app&apos;) {
                    echo &apos;Creating virtual environment and installing dependencies...&apos;
                    sh &apos;&apos;&apos;
                        python3 -m venv &quot;$VENV&quot;
                        &quot;$VENV/bin/python&quot; -m pip install -r requirements.txt
                        &quot;$VENV/bin/python&quot; -m pip check
                    &apos;&apos;&apos;
                }
            }
        }

        stage(&apos;Test&apos;) {
            steps {
                dir(&apos;python-flask-app&apos;) {
                    echo &apos;Running unit tests...&apos;
                    sh &apos;&apos;&apos;
                        &quot;$VENV/bin/python&quot; -m unittest discover -s . -p &quot;test_*.py&quot;
                    &apos;&apos;&apos;
                }
            }
        }

        stage(&apos;Deploy&apos;) {
            steps {
                dir(&apos;python-flask-app&apos;) {
                    echo &apos;Deploying application...&apos;
                    sh &apos;&apos;&apos;
                        mkdir -p &quot;$DEPLOY_DIR&quot;
                        cp app.py &quot;$DEPLOY_DIR/&quot;
                    &apos;&apos;&apos;
                }
            }
        }

        stage(&apos;Run Application&apos;) {
            steps {
                dir(&apos;python-flask-app&apos;) {
                    echo &apos;Starting deployed Flask HTTP server...&apos;
                    sh &apos;&apos;&apos;
                        &quot;$VENV/bin/python&quot; pipeline_runtime.py start --deployed &quot;$DEPLOY_DIR/app.py&quot;
                    &apos;&apos;&apos;
                }
            }
        }

        stage(&apos;Test Application&apos;) {
            steps {
                dir(&apos;python-flask-app&apos;) {
                    echo &apos;Testing deployed application over HTTP...&apos;
                    sh &apos;&apos;&apos;
                        &quot;$VENV/bin/python&quot; pipeline_runtime.py verify --deployed &quot;$DEPLOY_DIR/app.py&quot; --source &quot;$WORKSPACE/python-flask-app/app.py&quot;
                    &apos;&apos;&apos;
                }
            }
        }
    }

    post {
        success {
            echo &apos;Pipeline completed successfully!&apos;
        }

        failure {
            echo &apos;Pipeline failed. Check the console output for details.&apos;
        }

        always {
            sh &apos;&apos;&apos;
                if [ -x &quot;$VENV/bin/python&quot; ]; then
                    &quot;$VENV/bin/python&quot; &quot;$WORKSPACE/python-flask-app/pipeline_runtime.py&quot; stop --deployed &quot;$DEPLOY_DIR/app.py&quot;
                fi
            &apos;&apos;&apos;
            archiveArtifacts artifacts: &apos;python-app-deploy/http-response.json,python-app-deploy/server-cleanup.json,python-app-deploy/app.log&apos;, allowEmptyArchive: true
            echo &apos;Pipeline execution finished.&apos;
        }
    }
}
</script>
